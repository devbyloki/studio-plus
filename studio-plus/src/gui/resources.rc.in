// Generated by CMake from src/gui/resources.rc.in: the app icon and the embedded fonts.
#include <winres.h>

1 ICON "@STUDIO_ICON@"

FONT_BODY RCDATA "@STUDIO_FONTS@/Montserrat-SemiBold.ttf"
FONT_HEADING RCDATA "@STUDIO_FONTS@/Montserrat-ExtraBold.ttf"
FONT_BRUSH RCDATA "@STUDIO_FONTS@/PermanentMarker-Regular.ttf"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ReSkate Studio+"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductName", "ReSkate Studio+"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "GPL-3.0"
            VALUE "OriginalFilename", "ReSkate Studio+.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
